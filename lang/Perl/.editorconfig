# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.pl,*.pm,*.t}]
indent_style = space
indent_size = 4
max_line_length = 78
# JetBrains IDEs have no built-in Perl support, so there are no ij_ keys to
# set. VS Code, Vim, Emacs and Neovim read only the standard properties above.

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80
