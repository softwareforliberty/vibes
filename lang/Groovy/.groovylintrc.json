{
  "extends": "recommended",
  "rules": {
    "formatting.Indentation": {
      "spacesPerIndentLevel": 4
    },
    "formatting.LineLength": {
      "length": 120
    },
    "formatting.SpaceAroundMapEntryColon": {
      "characterAfterColonRegex": "\\s"
    },
    "size.CyclomaticComplexity": {
      "maxMethodComplexity": 10
    },
    "size.MethodSize": {
      "maxLines": 60
    }
  }
}
