# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.f90]
indent_style = space
indent_size = 4
max_line_length = 100
# No verified IDE-specific EditorConfig keys exist for Fortran. VS Code, Vim,
# Emacs and Neovim read only the standard properties above.

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

[*.toml]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_toml_keep_indents_on_empty_lines = false
