[{elvis, [
    {config, [
        #{dirs => ["src"],
          filter => "*.erl",
          ruleset => erl_files,
          rules => [
              {elvis_style, no_call, #{no_call_functions => [
                  {erlang, list_to_atom, 1},
                  {erlang, binary_to_atom, 2},
                  {erlang, binary_to_term, 1},
                  {os, cmd, 1}
              ]}}
          ]}
    ]}
]}].
