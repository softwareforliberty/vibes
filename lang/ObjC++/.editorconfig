# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Objective-C++, Objective-C and C++ sources and headers: 2 spaces (see
# coding-style.md). clang-format (.clang-format) is the source of truth for
# everything else. Xcode, Vim and Emacs read only the standard properties.
[*.{cc,h,m,mm}]
indent_style = space
indent_size = 2

# JetBrains IDEs (CLion)
ij_continuation_indent_size = 4
ij_c_namespace_brace_placement = end_of_line
ij_c_function_brace_placement = end_of_line
ij_c_method_brace_placement = end_of_line
ij_c_block_brace_placement = end_of_line
ij_c_else_on_new_line = false
ij_c_catch_on_new_line = false
ij_c_while_on_new_line = false
ij_c_if_brace_force = always
ij_c_for_brace_force = always
ij_c_while_brace_force = always
ij_c_do_while_brace_force = always
ij_c_indent_namespace_members = 0
ij_c_indent_class_members = 2
ij_c_indent_visibility_keywords = 1
ij_c_indent_case_from_switch = true
ij_c_method_parameters_align_by_colons = true
ij_c_method_call_arguments_align_by_colons = true
ij_c_space_before_pointer_in_declaration = true
ij_c_space_after_pointer_in_declaration = false
ij_c_space_before_reference_in_declaration = true
ij_c_space_after_reference_in_declaration = false

# Visual Studio, and VS Code with the C/C++ extension (C++ code only).
# Visual Studio can't indent access specifiers by 1 space; clang-format does.
cpp_new_line_before_open_brace_namespace = same_line
cpp_new_line_before_open_brace_type = same_line
cpp_new_line_before_open_brace_function = same_line
cpp_new_line_before_open_brace_block = same_line
cpp_new_line_before_open_brace_lambda = same_line
cpp_new_line_before_else = false
cpp_new_line_before_catch = false
cpp_new_line_before_while_in_do_while = false
cpp_indent_namespace_contents = false
cpp_indent_access_specifiers = false
cpp_indent_case_labels = true
cpp_indent_case_contents = true
cpp_space_pointer_reference_alignment = right
cpp_space_after_keywords_in_control_flow_statements = true
cpp_space_before_function_open_parenthesis = remove
cpp_space_after_cast_close_parenthesis = false

# Objective-C and Objective-C++ files: 100 columns. A header that holds only
# C++ keeps to 80, which clang-format enforces with its Cpp section.
[*.{h,m,mm}]
max_line_length = 100
ij_visual_guides = 100

# Pure C++ files: 80 columns
[*.cc]
max_line_length = 80
ij_visual_guides = 80

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_yaml_align_values_properties = do_not_align
ij_yaml_autoinsert_sequence_marker = true
ij_yaml_block_mapping_on_new_line = false
ij_yaml_indent_sequence_value = true
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true
ij_yaml_sequence_on_new_line = false
ij_yaml_space_before_colon = false
ij_yaml_spaces_within_braces = false
ij_yaml_spaces_within_brackets = false
