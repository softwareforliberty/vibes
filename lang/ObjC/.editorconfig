# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Objective-C sources and headers: 2 spaces, 100 columns (see coding-style.md).
# clang-format (.clang-format) is the source of truth for everything else.
# Xcode, VS Code, Vim and Emacs read only the standard properties here.
[*.{h,m}]
indent_style = space
indent_size = 2
max_line_length = 100

# JetBrains IDEs (CLion)
ij_visual_guides = 100
ij_continuation_indent_size = 4
ij_c_function_brace_placement = end_of_line
ij_c_method_brace_placement = end_of_line
ij_c_block_brace_placement = end_of_line
ij_c_else_on_new_line = false
ij_c_while_on_new_line = false
ij_c_if_brace_force = always
ij_c_for_brace_force = always
ij_c_while_brace_force = always
ij_c_do_while_brace_force = always
ij_c_indent_case_from_switch = true
ij_c_method_parameters_align_by_colons = true
ij_c_method_call_arguments_align_by_colons = true
ij_c_space_before_pointer_in_declaration = true
ij_c_space_after_pointer_in_declaration = false

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80
