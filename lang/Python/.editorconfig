# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 88
# JetBrains IDEs
ij_continuation_indent_size = 4
ij_visual_guides = 72,88
ij_wrap_on_typing = false
ij_python_blank_lines_after_imports = 1
ij_python_blank_lines_around_class = 1
ij_python_blank_lines_around_method = 1
ij_python_blank_lines_around_top_level_classes_functions = 2
ij_python_optimize_imports_sort_imports = true

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

[*.toml]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_toml_keep_indents_on_empty_lines = false

[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_yaml_align_values_properties = do_not_align
ij_yaml_autoinsert_sequence_marker = true
ij_yaml_block_mapping_on_new_line = false
ij_yaml_indent_sequence_value = true
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true
ij_yaml_sequence_on_new_line = false
ij_yaml_space_before_colon = false
ij_yaml_spaces_within_braces = false
ij_yaml_spaces_within_brackets = false

# VS Code, Vim, Emacs and Neovim read only the standard properties above.
