# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C sources and headers: tabs 8 wide, 80 columns (see coding-style.md)
[*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 80

# JetBrains IDEs (CLion)
ij_visual_guides = 80
ij_c_function_brace_placement = next_line
ij_c_block_brace_placement = end_of_line
ij_c_else_on_new_line = false
ij_c_while_on_new_line = false
ij_c_indent_case_from_switch = false
ij_c_keep_control_statement_in_one_line = false
ij_c_keep_simple_blocks_in_one_line = false
ij_c_function_parameters_align_multiline = true
ij_c_function_call_arguments_align_multiline = true
ij_c_space_before_pointer_in_declaration = true
ij_c_space_after_pointer_in_declaration = false
ij_c_indent_preprocessor_directive = 0
ij_c_keep_directive_at_first_column = true

# Visual Studio, and VS Code with the C/C++ extension
cpp_new_line_before_open_brace_function = new_line
cpp_new_line_before_open_brace_block = same_line
cpp_new_line_before_open_brace_type = same_line
cpp_new_line_before_else = false
cpp_new_line_before_while_in_do_while = false
cpp_indent_case_labels = false
cpp_indent_case_contents = true
cpp_indent_preprocessor = leftmost_column
cpp_indent_goto_labels = leftmost_column
cpp_indent_multi_line_relative_to = innermost_parenthesis
cpp_space_pointer_reference_alignment = right
cpp_space_after_keywords_in_control_flow_statements = true
cpp_space_before_function_open_parenthesis = remove
cpp_space_after_cast_close_parenthesis = false

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_yaml_align_values_properties = do_not_align
ij_yaml_autoinsert_sequence_marker = true
ij_yaml_block_mapping_on_new_line = false
ij_yaml_indent_sequence_value = true
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true
ij_yaml_sequence_on_new_line = false
ij_yaml_space_before_colon = false
ij_yaml_spaces_within_braces = false
ij_yaml_spaces_within_brackets = false
