#!/usr/bin/env bash
#
# Writes what another coding agent needs to run vibes from this checkout:
#
#   host-files codex <agents directory>       Codex's custom agents
#   host-files gemini <extension directory>   a Gemini CLI extension
#
# lib/host_files/cli.py describes what each holds. Exits 0, and 2 on an
# error. Needs Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from host_files.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
