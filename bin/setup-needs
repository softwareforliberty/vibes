#!/usr/bin/env bash
#
# Lists the settings a branch needs a person to provide, such as an API key
# the code now reads or a GitHub secret a workflow now names, so a run can
# write a wizard for them:
#
#   setup-needs <base>
#
# lib/setup_needs/cli.py says what it finds. Exits 0, or 2 on an error.
# Needs Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from setup_needs.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
