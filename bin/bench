#!/usr/bin/env bash
#
# Measures whether a change made a program faster, and by how much. It runs
# a benchmark harness against two trees in interleaved pairs, compares them
# with a bootstrap confidence interval, and decides a verdict beyond the
# noise an A/A run measured:
#
#   bench run --out <dir> --a <tree> --b <tree> [options] -- <command {tree}>
#   bench import --out <dir> --a <file[#n]> --b <file[#n]>
#   bench tests --out <dir> --tree <tree> -- <test command>
#   bench compare --out <dir>
#   bench verdict --out <dir> [--noise <dir>] [--guard rss_kib=10]
#
# lib/bench/cli.py describes every option. Exits 0 when it worked and 2 on
# an error. Needs Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from bench.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
