#!/usr/bin/env bash
#
# Checks a logic prototype from /vibes:prototype keeps its rules: it loads
# nothing from outside, its logic never touches the page, and it states
# its question and has at least two scenarios with steps:
#
#   prototype-check <prototype.html>
#
# lib/prototype_check/cli.py describes the rules. Exits 0 when it keeps
# them, 1 when it doesn't, and 2 on an error. Needs Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from prototype_check.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
