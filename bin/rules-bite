#!/usr/bin/env bash
#
# Checks each boundary rule in scripts/check still fails on the breach that
# proved it, kept in scripts/breaches/<rule>.patch:
#
#   rules-bite [--staged]
#
# lib/rules_bite/cli.py describes the patches and what it prints. Exits 0
# when every breach bites, 1 when any doesn't, and 2 on an error. Needs
# Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from rules_bite.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
