#!/usr/bin/env bash
#
# Prepares an untrusted pull request for review, without running anything
# in it: fetches it and the forge's record of it, then scans it with pr-scan
# into .vibes/pr-<number>/. Run it from the repository the pull request is
# for:
#
#   pr-prepare [--forge github|gitlab|forgejo] <number or address>
#   pr-prepare --fetch <remote> <ref> [<base branch>]
#   pr-prepare --local <base> <head> [<name>]
#   pr-prepare --branch [<base branch>]
#
# The first form fetches a pull request from GitHub with gh, a merge
# request from GitLab with glab, or a pull request from Forgejo, Codeberg
# or Gitea with tea, each through the forge's own CLI and login. The forge
# is told by the address, or by the origin remote's host for a number, or
# by --forge. The forge's record of it, its title, description, author and
# commits, goes to meta/pr.json, as lib/pr_scan/forge.py describes, and its
# head is checked against the commit the forge reports. The second form
# fetches any ref from a remote into refs/vibes/fetch/, for a forge with no
# CLI here, and reviews it from where it left the base branch, the
# remote's default branch unless one is named, with no record. The third
# reviews a local branch or commit range, with no record, into
# .vibes/pr-<name>/. The third reviews the checked-out branch
# since it left its base branch, the remote's default branch unless one is
# named, into .vibes/review-<branch>/. Uncommitted changes to tracked files
# are included, as a commit object made from them that no ref points to, so
# the working tree, the index and the branch are left as they were. New
# files not yet added are listed in untracked.txt, and not reviewed.
#
# Git runs only tree-to-tree commands, with hooks, filters, external diff
# programs, textconv, LFS and submodules turned off, and nothing is checked
# out. It prints only validated SHAs, counts and guide names, never text from
# the pull request. Exits 0 when the scan finds nothing, 1 when it finds
# something and 2 on an error, whose details go to the review directory's
# prepare.log.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT
# shellcheck source=hooks/lib/guides.sh
source "${ROOT}/hooks/lib/guides.sh"

readonly SHA_RE='^[0-9a-f]{40}$'
readonly REF_RE='^[A-Za-z0-9._/-]+$'
readonly NAME_RE='^[A-Za-z0-9._-]+$'
LOG=/dev/null

die() {
  printf 'pr-prepare: %s\n' "$*" >&2
  exit 2
}

# Runs git with everything that could run code from the repository turned
# off.
safe_git() {
  env GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1 GIT_PAGER=cat \
    GIT_CONFIG_NOSYSTEM=1 GIT_EXTERNAL_DIFF= GIT_SSH_COMMAND= \
    git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -c diff.external= -c log.showSignature=false \
    -c protocol.file.allow=never -c protocol.ext.allow=never \
    -c submodule.recurse=false -c fetch.recurseSubmodules=false "$@"
}

# Moves an earlier review aside, rather than deleting it.
fresh_directory() {
  local out="$1"
  if [[ -e "${out}" ]]; then
    mv -- "${out}" "${out}.$(date +%Y%m%d%H%M%S)"
  fi
  mkdir -p -- "${out}/meta" "${out}/review/round-1"
  [[ -f .vibes/.gitignore ]] || printf '*\n' >.vibes/.gitignore
}

# Prints the branch that the checked-out one was made from: the remote's
# default branch, or else main, master or trunk.
default_branch() {
  local ref
  if ref="$(safe_git symbolic-ref --quiet --short refs/remotes/origin/HEAD)"; then
    printf '%s\n' "${ref}"
    return 0
  fi
  for ref in main master trunk; do
    if safe_git rev-parse --verify --quiet "refs/heads/${ref}" >/dev/null; then
      printf '%s\n' "${ref}"
      return 0
    fi
  done
  return 1
}

# Prints a commit holding the working tree's tracked files on top of HEAD,
# or HEAD when nothing is uncommitted. Only objects are written: no ref, no
# index and no file changes.
working_head() {
  local stash tree
  stash="$(safe_git stash create)" || die "git stash create failed"
  if [[ -z "${stash}" ]]; then
    safe_git rev-parse HEAD
    return 0
  fi
  tree="$(safe_git rev-parse "${stash}^{tree}")"
  safe_git commit-tree "${tree}" -p HEAD -m "Uncommitted changes" \
    || die "git commit-tree failed: set user.name and user.email"
}

# Prints the forge a pull request address names, or for a bare number, the
# one the origin remote is on: github, gitlab or forgejo. Prints nothing
# when it can't tell.
forge_of() {
  local target="$1" url host
  case "${target}" in
    */-/merge_requests/*) printf 'gitlab\n'; return 0 ;;
    */pulls/*) printf 'forgejo\n'; return 0 ;;
    */pull/*) printf 'github\n'; return 0 ;;
    *) ;;
  esac
  url="$(safe_git remote get-url origin 2>/dev/null)" || return 0
  host="${url#*://}"
  host="${host#*@}"
  host="${host%%[:/]*}"
  case "${host}" in
    github.com | *.github.com | *.ghe.com) printf 'github\n' ;;
    gitlab.* | *.gitlab.* | *gitlab*) printf 'gitlab\n' ;;
    codeberg.org | *forgejo* | *gitea*) printf 'forgejo\n' ;;
    *) ;;
  esac
}

# Saves GitHub's record of the pull request, raw, for pr-scan record.
record_github() {
  local number="$1" meta="$2"
  command -v gh >/dev/null || die "needs the GitHub CLI, gh"
  gh api "repos/{owner}/{repo}/pulls/${number}" >"${meta}/pull.json" \
    2>>"${LOG}" || die "gh couldn't read pull request ${number}"
  gh api "repos/{owner}/{repo}/pulls/${number}/commits?per_page=100" \
    --paginate --jq '.[]' >"${meta}/commits.json" 2>>"${LOG}" \
    || die "gh couldn't read the pull request's commits"
}

# The most commits whose signatures are fetched from GitLab, one call each,
# and the most pages of commits read from Forgejo or Gitea. Past them, the
# record says the forge didn't say.
readonly MOST_SIGNATURES=250
readonly MOST_PAGES=20
readonly PAGE_SIZE=50

# Saves GitLab's record of the merge request, raw, for pr-scan record: the
# merge request, its commits, the project, for its clone address, and each
# commit's signature. GitLab answers 404 for an unsigned commit, which
# leaves no signature file, so the record says it can't tell.
record_gitlab() {
  local number="$1" meta="$2" sha count=0
  command -v glab >/dev/null || die "needs the GitLab CLI, glab"
  glab api "projects/:fullpath/merge_requests/${number}" \
    >"${meta}/merge-request.json" 2>>"${LOG}" \
    || die "glab couldn't read merge request ${number}"
  glab api "projects/:fullpath" >"${meta}/project.json" 2>>"${LOG}" \
    || die "glab couldn't read the project"
  if glab api --paginate --output ndjson \
    "projects/:fullpath/merge_requests/${number}/commits" \
    >"${meta}/commits.json" 2>>"${LOG}"; then
    mkdir -p -- "${meta}/signatures"
    while IFS= read -r sha; do
      count=$((count + 1))
      ((count <= MOST_SIGNATURES)) || break
      glab api "projects/:fullpath/repository/commits/${sha}/signature" \
        >"${meta}/signatures/${sha}.json" 2>>"${LOG}" \
        || rm -f -- "${meta}/signatures/${sha}.json"
    done < <("${ROOT}/bin/pr-scan" commits --forge gitlab --meta "${meta}")
  else
    rm -f -- "${meta}/commits.json"
  fi
}

# Saves Forgejo's or Gitea's record of the pull request, raw, through tea's
# raw API calls, a page of commits at a time. tea api exits 0 on an error
# response, so pr-scan record checks every answer.
record_forgejo() {
  local number="$1" meta="$2" page=1 file
  command -v tea >/dev/null || die "needs Gitea's CLI, tea"
  tea api --help >/dev/null 2>&1 || die "needs tea 0.12 or later, with tea api"
  tea api "/repos/{owner}/{repo}/pulls/${number}" >"${meta}/pull.json" \
    2>>"${LOG}" || die "tea couldn't read pull request ${number}"
  while ((page <= MOST_PAGES)); do
    file="${meta}/commits-${page}.json"
    tea api "/repos/{owner}/{repo}/pulls/${number}/commits?page=${page}&limit=${PAGE_SIZE}&files=false" \
      >"${file}" 2>>"${LOG}" || {
      rm -f -- "${file}"
      break
    }
    # A page shorter than the rest is the last.
    (($(grep -o '"sha":' "${file}" | wc -l) >= PAGE_SIZE)) || break
    page=$((page + 1))
  done
}

# Fetches the pull request's head and its base branch into refs/vibes/,
# from the forge's record of it, and checks the head is the one the forge
# reports.
fetch_pull() {
  local forge="$1" number="$2" out="$3" key line lines head="" base_ref=""
  local url="" ref fetched
  "record_${forge}" "${number}" "${out}/meta"
  lines="$("${ROOT}/bin/pr-scan" record --forge "${forge}" \
    --meta "${out}/meta" 2>>"${LOG}")" \
    || die "the forge's record of it didn't check out; see ${out}/prepare.log"
  while IFS=' ' read -r key line; do
    case "${key}" in
      HEAD) head="${line}" ;;
      BASE) base_ref="${line}" ;;
      URL) url="${line}" ;;
      *) ;;
    esac
  done <<<"${lines}"
  [[ "${head}" =~ ${SHA_RE} && "${base_ref}" =~ ${REF_RE} && -n "${url}" ]] \
    || die "the forge's record of it didn't check out; see ${out}/prepare.log"
  case "${forge}" in
    gitlab) ref="refs/merge-requests/${number}/head" ;;
    *) ref="refs/pull/${number}/head" ;;
  esac
  safe_git fetch --no-tags --no-recurse-submodules --quiet "${url}" \
    "+${ref}:refs/vibes/pr/${number}" \
    "+refs/heads/${base_ref}:refs/vibes/pr/${number}-base" >>"${LOG}" 2>&1 \
    || die "git couldn't fetch the pull request; see ${out}/prepare.log"
  fetched="$(safe_git rev-parse --verify --quiet "refs/vibes/pr/${number}")"
  [[ "${fetched}" == "${head}" ]] \
    || die "the fetched head isn't the one the forge reports: it moved, so run this again"
}

# Writes guides.txt: the guides the changed files need, from each file's
# path and the first line of its snapshot.
write_guides() {
  local out="$1" path view entries
  local guides="" unknown=""
  while IFS=$'\t' read -r path view; do
    entries="$(guides::for_file "${path}" "${view}")"
    if [[ -z "${entries}" ]]; then
      unknown+="no guide: ${path}"$'\n'
    else
      guides+="${entries}"$'\n'
    fi
  done <"${out}/guides-input.tsv"
  {
    printf '%s' "${guides}" | grep -vx -- '-' | sort -u || true
    printf '%s' "${unknown}"
  } >"${out}/guides.txt"
}

main() {
  local base head name number="" out target branch forge="" meta=""
  local status=0
  (($# > 0)) || die "usage: pr-prepare [--forge <forge>] <number or address> | --fetch <remote> <ref> [<base branch>] | --local <base> <head> [<name>] | --branch [<base branch>]"
  cd -- "$(safe_git rev-parse --show-toplevel 2>/dev/null)" \
    || die "run it inside the repository the pull request is for"
  if [[ "$1" == "--branch" ]]; then
    target="${2:-}"
    if [[ -z "${target}" ]]; then
      target="$(default_branch)" \
        || die "can't tell the base branch: name it, such as --branch main"
    fi
    safe_git rev-parse --verify --quiet "${target}^{commit}" >/dev/null \
      || die "no such branch: ${target}"
    base="$(safe_git merge-base "${target}" HEAD)" \
      || die "the branch shares no history with ${target}"
    head="$(working_head)"
    [[ "${base}" != "${head}" ]] \
      || die "nothing to review: no commits or changes since ${target}"
    branch="$(safe_git symbolic-ref --quiet --short HEAD || echo detached)"
    name="$(printf '%s' "${branch}" | tr -c 'A-Za-z0-9._-' '-')"
    out=".vibes/review-${name}"
    fresh_directory "${out}"
    LOG="${out}/prepare.log"
    safe_git ls-files --others --exclude-standard >"${out}/untracked.txt"
  elif [[ "$1" == "--fetch" ]]; then
    (($# >= 3)) || die "usage: pr-prepare --fetch <remote> <ref> [<base branch>]"
    safe_git remote get-url "$2" >/dev/null 2>&1 || die "no such remote: $2"
    [[ "$3" =~ ${REF_RE} && "$3" != -* && "$3" != *..* ]] \
      || die "not a ref: $3"
    name="$(printf '%s' "$3" | tr -c 'A-Za-z0-9._-' '-')"
    name="${name#refs-}"
    out=".vibes/pr-${name}"
    fresh_directory "${out}"
    LOG="${out}/prepare.log"
    safe_git fetch --no-tags --no-recurse-submodules --quiet "$2" \
      "+$3:refs/vibes/fetch/${name}" >>"${LOG}" 2>&1 \
      || die "git couldn't fetch $3 from $2; see ${out}/prepare.log"
    head="$(safe_git rev-parse --verify --quiet "refs/vibes/fetch/${name}")"
    target="${4:-}"
    if [[ -z "${target}" ]]; then
      target="$(default_branch)" \
        || die "can't tell the base branch: name it after the ref"
    fi
    base="$(safe_git merge-base "${target}" "${head}")" \
      || die "the ref shares no history with ${target}"
  elif [[ "$1" == "--local" ]]; then
    (($# >= 3)) || die "usage: pr-prepare --local <base> <head> [<name>]"
    base="$(safe_git rev-parse --verify --quiet "$2^{commit}")" \
      || die "no such commit: $2"
    head="$(safe_git rev-parse --verify --quiet "$3^{commit}")" \
      || die "no such commit: $3"
    name="${4:-local-${head:0:12}}"
    [[ "${name}" =~ ${NAME_RE} ]] || die "the name may hold only letters, digits, ., _ and -"
    out=".vibes/pr-${name}"
    fresh_directory "${out}"
    LOG="${out}/prepare.log"
  else
    if [[ "$1" == "--forge" ]]; then
      (($# >= 3)) || die "usage: pr-prepare --forge <forge> <number>"
      forge="$2"
      shift 2
    fi
    [[ -n "${forge}" ]] || forge="$(forge_of "$1")"
    case "${forge}" in
      github | gitlab | forgejo) ;;
      "") die "can't tell which forge the pull request is on: give its \
address, or --forge github, gitlab or forgejo, or fetch it with --fetch" ;;
      *) die "no such forge: ${forge}" ;;
    esac
    if [[ "$1" =~ /(pull|pulls|merge_requests)/([0-9]+)([/?#]|$) ]]; then
      number="${BASH_REMATCH[2]}"
    elif [[ "$1" =~ ^[0-9]+$ ]]; then
      number="$1"
    else
      die "not a pull request number or address"
    fi
    out=".vibes/pr-${number}"
    fresh_directory "${out}"
    LOG="${out}/prepare.log"
    fetch_pull "${forge}" "${number}" "${out}"
    base="refs/vibes/pr/${number}-base"
    head="refs/vibes/pr/${number}"
    meta="${out}/meta"
  fi
  "${ROOT}/bin/pr-scan" scan --repo . --base "${base}" --head "${head}" \
    --out "${out}" ${meta:+--meta "${meta}"} || status=$?
  ((status <= 1)) || die "the scan failed"
  write_guides "${out}"
  cp -- "${out}/diff.patch" "${out}/files.txt" "${out}/review/round-1/"
  printf 'pr-prepare: review directory %s\n' "$(pwd)/${out}"
  printf 'pr-prepare: guides %s\n' "$(grep -v '^no guide: ' \
    "${out}/guides.txt" | tr '\n' ' ')"
  printf 'pr-prepare: files no guide covers %s\n' \
    "$(grep -c '^no guide: ' "${out}/guides.txt" || true)"
  if [[ -f "${out}/untracked.txt" ]]; then
    printf 'pr-prepare: base %s, head %s\n' "${base}" "${head}"
    printf 'pr-prepare: new files not added to git, not reviewed %s\n' \
      "$(wc -l <"${out}/untracked.txt" | tr -d ' ')"
  fi
  return "${status}"
}

main "$@"
