#!/usr/bin/env bash
#
# Prints a compact digest of a Claude Code session's transcript, for a
# retrospective: every tool call on one line with a reference, and the
# replies, failures, hook blocks, repeated calls and largest results:
#
#   session-digest [--project <dir>] <transcript or session id>
#   session-digest --show <ref> [--project <dir>] <transcript or session id>
#
# lib/session_digest/cli.py describes both. Exits 0 when it worked and 2 on
# an error. Needs Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from session_digest.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
