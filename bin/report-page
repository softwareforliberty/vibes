#!/usr/bin/env bash
#
# Turns a Markdown report, with Mermaid diagrams, into one HTML page to
# open in a browser:
#
#   report-page <report.md> <report.html>
#
# lib/report_page/cli.py describes the page. Exits 0 when it worked and 2
# on an error. Needs Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from report_page.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
