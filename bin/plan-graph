#!/usr/bin/env bash
#
# Reads the task graph in a rebuild plan: which batches can start now, the
# most that could ever run at once, and any two that could run at once but
# touch the same files:
#
#   plan-graph <rebuild-plan.md> [--done <batches>] [--running <batches>]
#
# lib/plan_graph/cli.py describes the plan's format. Exits 0, 1 when there
# are problems, and 2 on an error. Needs Python 3.9 or later.

set -euo pipefail

ROOT="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.."
readonly ROOT

# -I ignores PYTHON* variables and the user's site directory, and -S skips
# site, so nothing outside the plugin is imported. -I also leaves the
# script's own directory off the path, so lib/ is added here.
exec python3 -I -S -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from plan_graph.cli import main; sys.exit(main(sys.argv[1:]))' \
  "${ROOT}/lib" "$@"
