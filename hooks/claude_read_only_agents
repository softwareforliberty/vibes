#!/usr/bin/env bash
#
# Claude Code PreToolUse hook that keeps the reviewers read-only. A reviewer
# may write only its own findings file in a review round's directory, so this
# blocks (exit 2) any other file it would write or edit. The spec reviewer may
# also build, test and run the program, and the commit message suggester may
# read the staged change, but neither may change files or git state, so this
# blocks any Bash command of theirs that would, and any write of the
# suggester's. The profiler may
# write and edit only its own files in an optimise run's state directory,
# never the project's code, so this blocks its other writes and edits. The
# retrospective may write only its report, and may run commands that read
# but none that change files or git. The surveyor may likewise write only
# its survey and comparison, the interface designer only its design, the
# researcher only its note, the pull request writer only its body and the
# list of its sources, the issue reader only its brief and triage, and the
# wizard writer only its wizard. It
# guards against mistakes, not a determined attacker: a program an agent runs
# can still write files.

set -euo pipefail

# shellcheck source=hooks/lib/hook_input.sh
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/lib/hook_input.sh"

# Reviewers, which may write only their own findings file.
REVIEWERS=" architecture-reviewer bug-reviewer cleanliness-reviewer"
REVIEWERS+=" idioms-reviewer performance-reviewer project-docs-reviewer"
REVIEWERS+=" resource-leak-reviewer security-reviewer spec-reviewer"
REVIEWERS+=" style-reviewer supply-chain-reviewer test-reviewer "
readonly REVIEWERS
# Agents that may write and edit only in an optimise run's state directory.
readonly PROFILERS=" profiler "
# Agents that may write only their report in a retrospective's directory.
readonly RETROSPECTIVES=" retrospective "
# Agents that may write only their own files in a survey's directory.
readonly SURVEYORS=" interface-designer surveyor "
# Agents that may write only a note in a run's research directory.
readonly RESEARCHERS=" researcher "
# Agents that may write only the body and its sources in a pull request's
# directory.
readonly PR_WRITERS=" pr-writer "
# Agents that may write only the brief and triage in an issue's directory.
readonly ISSUE_READERS=" issue-reader "
# Agents that may write only a run's wizard.
readonly WIZARD_WRITERS=" wizard-writer "
# Agents whose Bash commands may not change files or git state.
READ_ONLY_SHELL=" commit-message-suggester retrospective spec-reviewer"
READ_ONLY_SHELL+=" researcher surveyor wizard-writer "
readonly READ_ONLY_SHELL
# git subcommands that only read.
GIT_READERS=" blame cat-file describe diff grep log ls-files ls-tree"
GIT_READERS+=" merge-base rev-parse shortlog show status "
readonly GIT_READERS
# Commands whose job is to change files.
FILE_WRITERS=" chgrp chmod chown cp dd install ln mkdir mv patch rm rmdir"
FILE_WRITERS+=" shred tee touch truncate unlink "
readonly FILE_WRITERS
# A redirection and its target: > file, >> file, 2> file or &> file.
readonly REDIRECT_RE='[0-9&]?>>?[[:space:]]*([^[:space:];&|<>()]+)'

# Succeeds when the path is the reviewer's own findings file in a round's
# directory, .vibes/<name>/review/<round>/<reviewer>.md. It's named after the
# reviewer alone because Claude Code refuses a subagent's write to a Markdown
# file whose name starts with findings or report.
is_findings_file() {
  local path="$1" reviewer="$2"
  [[ "${path}" == /* && "${path}" != *"/../"* ]] \
    && [[ "${path}" == */.vibes/*/review/*/"${reviewer}.md" ]] \
    && [[ "${path#*/.vibes/*/review/}" != */*/* ]]
}

# Succeeds when the path is in an optimise run's state directory,
# .vibes/optimise-<slug>/, other than its worktrees in wt/, which hold the
# project's code.
is_profiler_file() {
  local path="$1"
  [[ "${path}" == /* && "${path}" != *"/../"* ]] \
    && [[ "${path}" == */.vibes/optimise-*/* ]] \
    && [[ "${path#*/.vibes/optimise-*/}" != wt/* ]]
}

# Succeeds when the path is the retrospective's report,
# .vibes/retro-<slug>/retro.md.
is_retro_file() {
  local path="$1"
  [[ "${path}" == /* && "${path}" != *"/../"* ]] \
    && [[ "${path}" == */.vibes/retro-*/retro.md ]] \
    && [[ "${path#*/.vibes/retro-}" != */*/* ]]
}

# Succeeds when the path is one the survey agent may write: the surveyor's
# .vibes/survey-<slug>/survey.md or comparison.md, or an interface
# designer's .vibes/survey-<slug>/designs/<letter>.md.
is_survey_file() {
  local path="$1" agent="$2" rest
  [[ "${path}" == /* && "${path}" != *"/../"* \
    && "${path}" == */.vibes/survey-*/* ]] || return 1
  rest="${path#*/.vibes/survey-}"
  rest="${rest#*/}"
  case "${agent}" in
    surveyor) [[ "${rest}" == survey.md || "${rest}" == comparison.md ]] ;;
    interface-designer) [[ "${rest}" == designs/*.md && "${rest}" != */*/* ]] ;;
    *) return 1 ;;
  esac
}

# Succeeds when the path is a research note, .vibes/<run>/research/<topic>.md.
is_research_file() {
  local path="$1" rest
  [[ "${path}" == /* && "${path}" != *"/../"* \
    && "${path}" == */.vibes/*/research/*.md ]] || return 1
  rest="${path#*/.vibes/}"
  [[ "${rest}" == */research/*.md && "${rest}" != */*/*/* ]]
}

# Succeeds when the path is a pull request's body or the list of its
# sources, .vibes/pr-<slug>/pr.md or sources.md.
is_pr_file() {
  local path="$1"
  [[ "${path}" == /* && "${path}" != *"/../"* ]] \
    && [[ "${path}" == */.vibes/pr-*/pr.md \
      || "${path}" == */.vibes/pr-*/sources.md ]] \
    && [[ "${path#*/.vibes/pr-}" != */*/* ]]
}

# Succeeds when the path is an issue's brief or triage,
# .vibes/issues/<number>/brief.md or triage.md.
is_issue_file() {
  local path="$1" rest
  [[ "${path}" == /* && "${path}" != *"/../"* \
    && "${path}" == */.vibes/issues/* ]] || return 1
  rest="${path#*/.vibes/issues/}"
  [[ "${rest}" =~ ^[0-9]+/(brief|triage)\.md$ ]]
}

# Succeeds when the path is a run's wizard, .vibes/<run>/wizard.sh.
is_wizard_file() {
  local path="$1"
  [[ "${path}" == /* && "${path}" != *"/../"* ]] \
    && [[ "${path}" == */.vibes/*/wizard.sh ]] \
    && [[ "${path#*/.vibes/}" != */*/* ]]
}

# Succeeds when the path is the one file a read-only agent may write: a
# reviewer's findings file, the retrospective's report, a survey's, or a
# research note.
is_own_file() {
  local path="$1" agent="$2"
  if [[ "${RESEARCHERS}" == *" ${agent} "* ]]; then
    is_research_file "${path}"
  elif [[ "${WIZARD_WRITERS}" == *" ${agent} "* ]]; then
    is_wizard_file "${path}"
  elif [[ "${RETROSPECTIVES}" == *" ${agent} "* ]]; then
    is_retro_file "${path}"
  elif [[ "${SURVEYORS}" == *" ${agent} "* ]]; then
    is_survey_file "${path}" "${agent}"
  else
    is_findings_file "${path}" "${agent}"
  fi
}

# Prints why a redirection in the command writes to a file, or nothing. The
# agent may redirect into its own file: Claude Code gives an agent with Bash
# no Write tool.
redirect_reason() {
  local rest="$1" reviewer="$2"
  while [[ "${rest}" =~ ${REDIRECT_RE} ]]; do
    if [[ "${BASH_REMATCH[1]}" != "/dev/null" ]] \
      && ! is_own_file "${BASH_REMATCH[1]}" "${reviewer}"; then
      printf 'it redirects output to %s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
    rest="${rest#*"${BASH_REMATCH[0]}"}"
  done
}

# Prints why git with these arguments changes git state, or nothing.
git_reason() {
  local -a args=("$@")
  local i=0
  # Skip git's own options, two of which take a value.
  while ((i < ${#args[@]})) && [[ "${args[i]}" == -* ]]; do
    case "${args[i]}" in
      -C | -c) ((i += 2)) ;;
      *) ((i += 1)) ;;
    esac
  done
  ((i < ${#args[@]})) || return 0
  local sub="${args[i]}"
  local next="${args[i + 1]:-}"
  if [[ "${GIT_READERS}" == *" ${sub} "* ]] \
    || [[ "${sub} ${next}" == "branch --show-current" ]] \
    || [[ "${sub} ${next}" == "stash list" ]] \
    || [[ "${sub} ${next}" == "config --get"* ]] \
    || [[ "${sub} ${next}" == "config --list" ]]; then
    return 0
  fi
  printf 'git %s can change git state\n' "${sub}"
}

# Prints why one simple command changes files or git state, or nothing.
command_reason() {
  local -a words
  read -r -a words <<<"$1"
  # Bash 3.2 treats an empty array as unset, which set -u rejects.
  ((${#words[@]} > 0)) || return 0
  local i=0
  # Skip variable assignments, shell keywords, and wrappers that run the
  # next word.
  while ((i < ${#words[@]})); do
    case "${words[i]}" in
      *=* | ! | '{' | if | then | else | elif | do | while | until | env | \
        command | exec | nice | nohup | sudo | time | xargs)
        ((i += 1))
        ;;
      *) break ;;
    esac
  done
  ((i < ${#words[@]})) || return 0
  local name="${words[i]##*/}"
  local word
  if [[ "${FILE_WRITERS}" == *" ${name} "* ]]; then
    printf '%s changes files\n' "${name}"
  elif [[ "${name}" == "git" ]]; then
    git_reason "${words[@]:i+1}"
  elif [[ " sed perl ruby " == *" ${name} "* ]]; then
    # -i, alone or among other short options, edits in place. -e, -I and
    # -M take values, which may contain an i.
    for word in "${words[@]:i+1}"; do
      case "${word}" in
        --in-place* | -i* | -[!-eIM]*i*)
          printf '%s %s edits files in place\n' "${name}" "${word}"
          return 0
          ;;
        *) ;;
      esac
    done
  fi
}

# Prints the first reason the reviewer's command changes files or git state,
# or nothing.
reason() {
  local command="$1" reviewer="$2" part found
  found="$(redirect_reason "${command}" "${reviewer}")"
  if [[ -n "${found}" ]]; then
    printf '%s\n' "${found}"
    return 0
  fi
  # Split into simple commands at ; & | ( ) and backquotes.
  while IFS= read -r part; do
    found="$(command_reason "${part}")"
    if [[ -n "${found}" ]]; then
      printf '%s\n' "${found}"
      return 0
    fi
  done <<<"${command//[;&|()\`]/$'\n'}"
}

main() {
  local input agent tool path command found
  input="$(cat)"
  agent="$(hook::json_field "${input}" '.agent_type')"
  agent="${agent#vibes:}"
  [[ -n "${agent}" ]] || exit 0
  tool="$(hook::json_field "${input}" '.tool_name')"
  if [[ "${PROFILERS}" == *" ${agent} "* ]]; then
    [[ "${tool}" != "Bash" ]] || exit 0
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_profiler_file "${path}"; then
      printf 'vibes: %s may write only in the run directory ' "${agent}" >&2
      printf '.vibes/optimise-<slug>/, outside wt/, never the code.\n' >&2
      exit 2
    fi
    exit 0
  fi
  if [[ "${tool}" == "Bash" ]]; then
    [[ "${READ_ONLY_SHELL}" == *" ${agent} "* ]] || exit 0
    command="$(hook::json_field "${input}" '.tool_input.command' \
      | hook::strip_text)"
    found="$(reason "${command}" "${agent}")"
    if [[ -n "${found}" ]]; then
      printf 'vibes: %s is read-only, and %s. ' "${agent}" "${found}" >&2
      printf 'It can run commands, but not change files or git.\n' >&2
      exit 2
    fi
    exit 0
  fi
  if [[ "${REVIEWERS}" == *" ${agent} "* ]]; then
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_findings_file "${path}" "${agent}"; then
      printf 'vibes: %s is read-only. It may write only ' "${agent}" >&2
      printf '%s.md in the review directory.\n' "${agent}" >&2
      exit 2
    fi
  elif [[ "${RESEARCHERS}" == *" ${agent} "* ]]; then
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_research_file "${path}"; then
      printf 'vibes: %s is read-only. It may write only ' "${agent}" >&2
      printf 'its note, .vibes/<run>/research/<topic>.md.\n' >&2
      exit 2
    fi
  elif [[ "${SURVEYORS}" == *" ${agent} "* ]]; then
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_survey_file "${path}" "${agent}"; then
      printf 'vibes: %s is read-only. It may write only ' "${agent}" >&2
      printf 'its own files in .vibes/survey-<slug>/.\n' >&2
      exit 2
    fi
  elif [[ "${RETROSPECTIVES}" == *" ${agent} "* ]]; then
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_retro_file "${path}"; then
      printf 'vibes: %s is read-only. It may write only ' "${agent}" >&2
      printf 'its report, .vibes/retro-<slug>/retro.md.\n' >&2
      exit 2
    fi
  elif [[ "${WIZARD_WRITERS}" == *" ${agent} "* ]]; then
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_wizard_file "${path}"; then
      printf 'vibes: %s may write only ' "${agent}" >&2
      printf 'the wizard, .vibes/<run>/wizard.sh.\n' >&2
      exit 2
    fi
  elif [[ "${ISSUE_READERS}" == *" ${agent} "* ]]; then
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_issue_file "${path}"; then
      printf 'vibes: %s is read-only. It may write only ' "${agent}" >&2
      printf 'brief.md and triage.md in .vibes/issues/<number>/.\n' >&2
      exit 2
    fi
  elif [[ "${PR_WRITERS}" == *" ${agent} "* ]]; then
    path="$(hook::json_field "${input}" '.tool_input.file_path')"
    if ! is_pr_file "${path}"; then
      printf 'vibes: %s is read-only. It may write only ' "${agent}" >&2
      printf 'pr.md and sources.md in .vibes/pr-<slug>/.\n' >&2
      exit 2
    fi
  elif [[ "${READ_ONLY_SHELL}" == *" ${agent} "* ]]; then
    printf 'vibes: %s is read-only, and may not write files.\n' "${agent}" >&2
    exit 2
  fi
}

main "$@"
