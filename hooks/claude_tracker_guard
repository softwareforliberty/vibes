#!/usr/bin/env bash
#
# PreToolUse hook that guards what vibes does to the project's issue
# tracker, through bin/tracker and .vibes-tracker:
#
# - Only the user approves the tracker's commands, in their own terminal,
#   so no agent may run `tracker approve`, or touch the approvals kept in
#   ~/.config/vibes/tracker-approvals/. In a sandbox, such as Claude
#   Code's, the system stops agents writing there anyway; this hook is for
#   sessions without one.
# - Public operations, such as a comment or a pull request, run only from
#   `tracker post <batch>`. A subagent may never run it; the main agent's
#   batch is shown to the user to confirm, or refused where the host can't
#   ask.
# - No subagent may write .vibes-tracker itself.
#
# It guards against mistakes and instructions an agent picks up from an
# issue, not a determined attacker: a program an agent runs can still
# write files.

set -euo pipefail

# shellcheck source=hooks/lib/hook_input.sh
source "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/lib/hook_input.sh"

# The approvals' directory, and the name approvals had before it.
readonly APPROVALS_RE='tracker-approvals|vibes-tracker-approved'
readonly TRACKER_FILE='.vibes-tracker'
# bin/tracker, however it's named, then the command and its first argument.
readonly TRACKER_RE='(^|[^A-Za-z0-9_.-])tracker["'"'"']?[[:space:]]+(approve|post)([[:space:]]+["'"'"']?([^"'"'"'[:space:];&|]+))?'
readonly MOST_LINES=40

# Blocks the call with a reason the agent sees.
refuse() {
  printf 'vibes tracker: %s\n' "$*" >&2
  exit 2
}

# Prints the batch's operations, one per line, for the user to confirm.
batch_lines() {
  local file="$1" cwd="$2"
  [[ "${file}" == /* || -z "${cwd}" ]] || file="${cwd}/${file}"
  if [[ ! -f "${file}" ]]; then
    printf '(the batch file %s, which does not exist yet)\n' "${file}"
    return 0
  fi
  head -n "${MOST_LINES}" -- "${file}" | tr '\t' ' ' | sed 's/^/- /'
}

check_command() {
  local input="$1" agent="$2" command cwd lines
  command="$(hook::json_field "${input}" '.tool_input.command')"
  [[ -n "${command}" ]] || return 0
  if [[ "${command}" =~ ${APPROVALS_RE} ]]; then
    refuse "only the user approves the tracker's commands, by running" \
      "\`tracker approve\` in their own terminal. No agent may touch" \
      "the approvals."
  fi
  [[ "${command}" =~ ${TRACKER_RE} ]] || return 0
  if [[ "${BASH_REMATCH[2]}" == approve ]]; then
    refuse "only the user approves the tracker's commands, in their own" \
      "terminal. Ask them to run \`tracker approve\` from the repository."
  fi
  if [[ -n "${agent}" ]]; then
    refuse "${agent} may not post to the issue tracker: only the main" \
      "agent does, with the user's confirmation."
  fi
  cwd="$(hook::json_field "${input}" '.cwd')"
  lines="$(batch_lines "${BASH_REMATCH[4]}" "${cwd}")"
  if ! hook::can_ask "${input}"; then
    refuse "posting to the issue tracker needs the user's confirmation," \
      "and this host can't ask for it from a hook. Give the user the" \
      "command to run themselves: ${command}"
  fi
  hook::pre_tool_ask "vibes will post to the issue tracker as you:"$'\n'"\
${lines}"$'\n'"Allow it only if this is what you approved."
}

check_write() {
  local input="$1" agent="$2" path
  path="$(hook::json_field "${input}" '.tool_input.file_path')"
  [[ -n "${path}" ]] || return 0
  if [[ "${path}" =~ ${APPROVALS_RE} ]]; then
    refuse "only the user approves the tracker's commands, by running" \
      "\`tracker approve\` in their own terminal."
  fi
  if [[ -n "${agent}" && "${path##*/}" == "${TRACKER_FILE}" ]]; then
    refuse "${agent} may not change ${TRACKER_FILE}, the commands vibes" \
      "runs against the issue tracker as the user."
  fi
}

main() {
  local input agent
  hook::read_input "$0"
  input="${HOOK_INPUT}"
  agent="$(hook::json_field "${input}" '.agent_type')"
  case "$(hook::json_field "${input}" '.tool_name')" in
    Bash) check_command "${input}" "${agent}" ;;
    *) check_write "${input}" "${agent}" ;;
  esac
}

main "$@"
