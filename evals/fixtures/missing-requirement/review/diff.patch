@@ -0,0 +1,34 @@
+"""Export stock reports."""
+
+import csv
+from collections.abc import Iterable
+from pathlib import Path
+
+from stock.models import Item
+
+# Spreadsheets run a cell that starts with one of these as a formula.
+_FORMULA_PREFIXES = ("=", "+", "-", "@", "\t", "\r")
+
+
+def _neutralise(text: str) -> str:
+    """Stop a spreadsheet from running text as a formula."""
+    return f"'{text}" if text.startswith(_FORMULA_PREFIXES) else text
+
+
+def export_low_stock_csv(items: Iterable[Item], path: Path) -> None:
+    """Write a low-stock report to a CSV file.
+
+    Args:
+        items: The items to write, in report order.
+        path: The file to write. An existing file is replaced.
+
+    Text that a spreadsheet would run as a formula is written with a leading
+    apostrophe, so opening the report can't run anything.
+    """
+    with path.open("w", newline="", encoding="utf-8") as file:
+        writer = csv.writer(file)
+        writer.writerow(["sku", "name", "quantity"])
+        for item in items:
+            writer.writerow(
+                [_neutralise(item.sku), _neutralise(item.name), item.quantity]
+            )
diff --git a/src/stock/repository.py b/src/stock/repository.py
index f282acf..06a74b4 100644
--- a/src/stock/repository.py
+++ b/src/stock/repository.py
@@ -15,6 +15,9 @@ class ItemRepository:
     def __init__(self, connection: sqlite3.Connection) -> None:
         """Use the given database connection."""
         self._connection = connection
+        # SQLite only folds the case of ASCII letters, so name searches use
+        # Python's full Unicode case folding instead.
+        connection.create_function("casefold", 1, str.casefold, deterministic=True)
 
     def get(self, sku: str) -> Item:
         """Load the item with the given SKU.
@@ -37,3 +40,32 @@ class ItemRepository:
                 "INSERT OR REPLACE INTO item (sku, name, quantity) VALUES (?, ?, ?)",
                 (item.sku, item.name, item.quantity),
             )
+
+    def find_low_stock(
+        self,
+        threshold: int,
+        *,
+        name_contains: str | None,
+        limit: int,
+        offset: int,
+    ) -> list[Item]:
+        """Load items with fewer than threshold on hand, fewest first.
+
+        Args:
+            threshold: Items with a quantity below this are included.
+            name_contains: If given, keep only items whose name contains
+                this text, ignoring case.
+            limit: The most items to return.
+            offset: How many matching items to skip.
+
+        Returns:
+            The matching items, sorted by quantity and then by SKU.
+        """
+        needle = "" if name_contains is None else name_contains.casefold()
+        rows = self._connection.execute(
+            "SELECT sku, name, quantity FROM item"
+            " WHERE quantity < ? AND instr(casefold(name), ?) > 0"
+            " ORDER BY quantity, sku LIMIT ? OFFSET ?",
+            (threshold, needle, limit, offset),
+        ).fetchall()
+        return [Item(*row) for row in rows]
