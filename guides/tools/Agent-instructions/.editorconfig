# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# CLAUDE.md, AGENTS.md, skills, agents and the files they point to.
[*.md]
indent_style = space
indent_size = 2
max_line_length = 79

# VS Code, Visual Studio, Vim, Emacs and Neovim read only the standard
# properties above.
