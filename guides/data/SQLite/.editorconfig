# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# SQLite files: queries, migrations and tests.
[*.sql]
indent_style = space
indent_size = 4
max_line_length = 80
# JetBrains IDEs (DataGrip, IntelliJ IDEA). Keyword and identifier case are
# set by SQLFluff in .sqlfluff; no published ij_sql_* key covers them.
ij_visual_guides = 80
ij_continuation_indent_size = 4

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

# VS Code, Vim, Emacs and Neovim read only the standard properties above.
