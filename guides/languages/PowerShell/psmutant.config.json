{
  "mutate": ["src/**/*.ps1"],
  "tests": {},
  "testsByConvention": true,
  "operators": [
    "BinaryOperator",
    "BooleanLiteral",
    "NumberLiteral",
    "NegationRemoval",
    "ConditionalBoundary",
    "ConditionForcing",
    "ReturnValue"
