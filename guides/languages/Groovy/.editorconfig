# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.groovy,*.gradle,Jenkinsfile}]
indent_style = space
indent_size = 4
max_line_length = 120
# JetBrains IDEs
ij_continuation_indent_size = 4
ij_groovy_class_count_to_use_import_on_demand = 999
ij_groovy_for_brace_force = always
ij_groovy_if_brace_force = always
ij_groovy_imports_layout = $*,|,*
ij_groovy_layout_static_imports_separately = true
ij_groovy_names_count_to_use_import_on_demand = 999
ij_groovy_use_single_class_imports = true
ij_groovy_while_brace_force = always

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{xml,xsd,rng,svg}]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_xml_align_attributes = false
ij_xml_attribute_wrap = off
ij_xml_keep_blank_lines = 1
ij_xml_keep_indents_on_empty_lines = false
ij_xml_keep_line_breaks = true
ij_xml_keep_whitespaces = false
ij_xml_space_after_tag_name = false
ij_xml_space_around_equals_in_attribute = false
ij_xml_space_inside_empty_tag = false
ij_xml_text_wrap = off

# VS Code, Eclipse, Vim, Emacs and Neovim read only the standard properties above.
