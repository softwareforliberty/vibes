# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Executables have no extension. shfmt matches them by their shebang through
# this section, which is a shfmt extension that editors ignore.
[[shell]]
indent_style = space
indent_size = 2
shell_variant = posix
binary_next_line = true
switch_case_indent = true

# POSIX sh libraries, and any other .sh files. shell_variant, binary_next_line and
# switch_case_indent are read by shfmt.
[*.sh]
indent_style = space
indent_size = 2
max_line_length = 80
shell_variant = posix
binary_next_line = true
switch_case_indent = true
# JetBrains IDEs
ij_visual_guides = 80
ij_continuation_indent_size = 2
ij_shell_binary_ops_start_line = true
ij_shell_keep_column_alignment_padding = false
ij_shell_minify_program = false
ij_shell_redirect_followed_by_space = false
ij_shell_switch_cases_indented = true
ij_shell_use_unix_line_separator = true
# VS Code, Vim, Emacs and Neovim read only the standard properties above.

# bats-core test files.
[*.bats]
indent_style = space
indent_size = 2
max_line_length = 80
shell_variant = bats
binary_next_line = true
switch_case_indent = true

# kcov's report holds its own helper scripts. shfmt skips this directory.
[coverage/**]
ignore = true

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_yaml_align_values_properties = do_not_align
ij_yaml_autoinsert_sequence_marker = true
ij_yaml_block_mapping_on_new_line = false
ij_yaml_indent_sequence_value = true
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true
ij_yaml_sequence_on_new_line = false
ij_yaml_space_before_colon = false
ij_yaml_spaces_within_braces = false
ij_yaml_spaces_within_brackets = false
