# Mutation operators for Bash and POSIX sh, read by universalmutator's
# --only. Each line is a regular expression, the arrow, and its
# replacement.

# Leave comments and the strict-mode line alone: no test can fail when
# they change.
^\s*# ==> DO_NOT_MUTATE
^set\s ==> DO_NOT_MUTATE
(^|\s)# ==> SKIP_MUTATING_REST

# Comparisons in test brackets: move each boundary and flip each test.
-lt ==> -le
-lt ==> -ge
-le ==> -lt
-le ==> -gt
-gt ==> -ge
-gt ==> -le
-ge ==> -gt
-ge ==> -lt
-eq ==> -ne
-ne ==> -eq
(\s)==?(\s) ==> \1!=\2
(\s)!=(\s) ==> \1=\2
(\[\[?\s+)-z ==> \1-n
(\[\[?\s+)-n ==> \1-z
&& ==> ||
\|\| ==> &&
(\s)! ==> \1

# Arithmetic in (( )) and $(( )). Redirections are never swapped, so a
# mutant can't turn a read into a write that empties a file.
(\s)<(\s) ==> \1<=\2
(\s)<=(\s) ==> \1<\2
(\s)>(\s) ==> \1>=\2
(\s)>=(\s) ==> \1>\2
(\s)\+(\s) ==> \1-\2
(\s)-(\s) ==> \1+\2

# Numbers that stand alone, such as limits and exit statuses: off by one,
# and zero.
([\s=(\[])(\d+)([\s)\];]) ==> \g<1>0\3
([\s=(\[])(\d+)([\s)\];]) ==> \1$((\2 + 1))\3
([\s=(\[])(\d+)([\s)\];]) ==> \1$((\2 - 1))\3

# Commands: delete each one by commenting it out.
(^\s*)(\S.*)\n ==> \1# \2\n
