# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# rustfmt's defaults: 4 spaces and a 100-column maximum width.
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100
# JetBrains IDEs
# RustRover: also turn on the Rustfmt setting "Use rustfmt instead of the
# built-in formatter". These keys keep the built-in formatter close to it.
ij_continuation_indent_size = 4
ij_rust_align_multiline_chained_methods = false
ij_rust_align_multiline_parameters = false
ij_rust_align_multiline_parameters_in_calls = false
ij_rust_allow_one_line_match = false
ij_rust_block_comment_at_first_column = false
ij_rust_keep_blank_lines_in_code = 1
ij_rust_keep_blank_lines_in_declarations = 1
ij_rust_keep_indents_on_empty_lines = false
ij_rust_line_comment_add_space = true
ij_rust_line_comment_at_first_column = false
# VS Code, Vim, Emacs and Neovim read only the standard properties above.

# Tool configs: Cargo.toml, clippy.toml and deny.toml.

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80

[*.toml]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_toml_keep_indents_on_empty_lines = false

[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 80
# JetBrains IDEs
ij_yaml_align_values_properties = do_not_align
ij_yaml_autoinsert_sequence_marker = true
ij_yaml_block_mapping_on_new_line = false
ij_yaml_indent_sequence_value = true
ij_yaml_keep_indents_on_empty_lines = false
ij_yaml_keep_line_breaks = true
ij_yaml_sequence_on_new_line = false
ij_yaml_space_before_colon = false
ij_yaml_spaces_within_braces = false
ij_yaml_spaces_within_brackets = false

# Tool configs: .opengrep/*.yaml.
