# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.erl,*.hrl,*.app.src,*.escript,rebar.config,elvis.config}]
indent_style = space
indent_size = 4
max_line_length = 100
# JetBrains IDEs, VS Code, Vim, Emacs and Neovim read only the standard
# properties above; none has Erlang-specific EditorConfig keys.

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80
