# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Makefiles: recipe lines must start with a tab, so indent with tabs. Type the
# 4-space indentation of continued lists and conditionals by hand.
[{Makefile,*.mk}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 80
# JetBrains IDEs
ij_smart_tabs = false
ij_visual_guides = 80
ij_wrap_on_typing = false
# VS Code, Visual Studio, Vim, Emacs and Neovim read only the standard
# properties above.

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80
