# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Linker scripts, plain and preprocessed: tabs 8 columns wide, 80 columns.
[*.{ld,ld.S}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 80
# JetBrains IDEs
ij_smart_tabs = false
ij_visual_guides = 80
ij_wrap_on_typing = false
# VS Code, Visual Studio, Vim, Emacs and Neovim read only the standard
# properties above.

[*.json]
indent_style = space
indent_size = 2
max_line_length = 80
